# Cổng web
PORT=8000
# Đường dẫn file lưu dữ liệu (MVP dùng JSON; giai đoạn sau thay PostgreSQL)
DB_PATH=./data/db.json
# Tài khoản admin tạo ở lần chạy đầu tiên (khi chưa có tài khoản nào).
# Để trống ADMIN_PASSWORD: hệ thống sinh mật khẩu ngẫu nhiên, in ra console MỘT lần và bắt đổi khi đăng nhập.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Tùy chọn: máy chủ OSRM để lấy ma trận đường thực, ví dụ http://localhost:5000
OSRM_URL=
# Tùy chọn: bảng hệ số nhiên liệu mặc định (bản admin sửa nằm ở data/fuels_active.json)
FUELS_CONFIG=./config/fuels.json
